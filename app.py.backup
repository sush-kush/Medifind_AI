from __future__ import annotations
import pandas as pd
import streamlit as st
import plotly.express as px
from src.data import load_data, text, join_hospitals, verification_label, is_provisional
from src.search import search_hospitals, search_doctors, search_services, ai_search

st.set_page_config(page_title="Medifind AI | Kolar healthcare discovery", page_icon="✚", layout="wide", initial_sidebar_state="expanded")

st.markdown("""
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');
:root{--ink:#153b38;--muted:#657d79;--teal:#087e74;--mint:#e8f5f1;--gold:#d69735}
html,body,[class*="css"]{font-family:'DM Sans',sans-serif;color:var(--ink)}
h1,h2,h3{font-family:'Manrope',sans-serif;letter-spacing:-.035em;color:#153b38}
.block-container{padding-top:1.4rem;padding-bottom:3rem;max-width:1280px}
.hero{background:linear-gradient(115deg,#e8f5f1 0%,#f4f8ef 55%,#fff8e9 100%);border:1px solid #dcebe5;border-radius:24px;padding:34px 38px;margin:10px 0 22px;position:relative;overflow:hidden}
.hero:after{content:'✚';position:absolute;right:45px;top:8px;font-size:130px;color:#087e7414;font-weight:800}
.eyebrow{color:#087e74;font-size:.76rem;letter-spacing:.13em;font-weight:700;text-transform:uppercase}
.hero h1{font-size:2.55rem;margin:.35rem 0 .4rem;line-height:1.08}.hero p{color:#506c66;font-size:1.04rem;max-width:680px}
